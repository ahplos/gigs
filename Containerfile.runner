# TEMPLATE FOR A DEFAULT GIG RUNNER
FROM registry.access.redhat.com/ubi10/ubi-minimal:latest
USER root

ARG GIG_DB_PKG=keydb
ARG GIG_DB_CLI=keydb-cli
ARG GIG_DB_SERVER=keydb-server
ARG GIG_DB_BENCHMARK=keydb-benchmark

ARG OC_TAR_GZ_FILE=openshift-client-linux.tar.gz
ARG OC_CLI_URL=https://mirror.openshift.com/pub/openshift-v4/x86_64/clients/ocp/latest/${OC_TAR_GZ_FILE}

ENV PYTHON_VERSION=3.12 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    PIP_NO_CACHE_DIR=off \
    HOME=/home/user \
    NPM_RUN=start \
    GO_REDIS_MODULE=github.com/redis/go-redis/v9

ENV NPM_CONFIG_PREFIX=$HOME/.npm-global \
    PATH=$HOME/node_modules/.bin/:$HOME/.npm-global/bin/:$PATH

WORKDIR ${HOME}

RUN <<EOF
    set -ex

    #### ADJUST FOLLOWING FOR OTHER BASE IMAGE DISTROS ####
    rpm -ivh https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm
    microdnf install --assumeyes --nodocs --setopt=install_weak_deps=0 \
        jq jo go git helm python${PYTHON_VERSION} nodejs npm tar gzip procps-ng ${GIG_DB_PKG} openssl
    microdnf clean all
    rm -rf /mnt/rootfs/var/cache/* /mnt/rootfs/var/log/dnf* /mnt/rootfs/var/log/yum.*
    #### END ADJUST FOLLOWING FOR OTHER DISTROS ####

    rm -f /usr/bin/${GIG_DB_BENCHMARK}
    ln -s /usr/bin/${GIG_DB_CLI} /usr/bin/gigdb-cli
    ln -s /usr/bin/${GIG_DB_SERVER} /usr/bin/gigdb-server

    curl -fsSLo /tmp/${OC_TAR_GZ_FILE} ${OC_CLI_URL}
    tar -C /usr/local/bin/ -xf /tmp/${OC_TAR_GZ_FILE} 'oc' 'kubectl'
    rm /tmp/${OC_TAR_GZ_FILE}

    npm install -g redis

    ln -s /usr/bin/python3 /usr/bin/python
    python -m ensurepip --upgrade
    python -m pip install jinja2 pyyaml redis

    go mod init steprun
    go get ${GO_REDIS_MODULE}
    echo 'package main' >> scratch.go
    echo "import (\"${GO_REDIS_MODULE}\")" >> scratch.go
    go clean -modcache
    go mod tidy
    rm go.*

    chmod -R 777 ${HOME}
EOF

USER 1001

ENTRYPOINT [ "bash", "-ce" ]