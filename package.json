{
  "name": "teknetes-gigs",
  "version": "0.0.1",
  "description": "Declartive, browser-based UI's from CRD's in Kubernetes",
  "private": true,
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/teknetes/teknetes-gigs.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "clean-all": "rm -rf dist node_modules",
    "build": "yarn clean && yarn install && NODE_ENV=prod yarn webpack",
    "build-dev": "yarn clean && yarn install && yarn webpack",
    "build-image": "build_image() { podman build --squash -f ${2:-Dockerfile} --tag $1; } ; build_image",
    "push-image": "push_image() { podman push --tls-verify=false $1; }; push_image",
    "build-push-image": "build_push_image() { yarn build-image $1 $2 && yarn push-image $1; }; build_push_image",
    "build-all": "build_all() { yarn build && yarn build-push-image $1 $2; }; build_all",
    "build-all-dev": "build_all_dev() { yarn build-dev && yarn build-push-image $1 $2; }; build_all_dev",
    "lint": "yarn eslint src integration-tests --fix && stylelint 'src/**/*.css' --allow-empty-input --fix",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "1.8.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.3.0",
    "@patternfly/react-core": "5.4.1",
    "@patternfly/react-icons": "5.4.1",
    "@patternfly/react-table": "5.4.1",
    "@patternfly/react-component-groups": "5.5.1",
    "@patternfly/react-log-viewer": "5.3.0",
    "@types/node": "^18.0.0",
    "@types/react": "^17.0.37",
    "@types/react-helmet": "^6.1.4",
    "@types/react-router-dom": "^5.3.2",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "css-loader": "^6.7.1",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.1",
    "i18next": "^19.0.0",
    "i18next-parser": "^3.11.0",
    "pluralize": "^8.0.0",
    "prettier": "^2.7.1",
    "prettier-stylelint": "^0.4.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-helmet": "^6.1.0",
    "react-i18next": "^11.7.3",
    "react-router": "5.3.x",
    "react-router-dom": "5.3.x",
    "style-loader": "^3.3.1",
    "stylelint": "^15.3.0",
    "stylelint-config-standard": "^31.0.0",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.8.1",
    "typescript": "^4.7.4",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.1.4"
  },
  "consolePlugin": {
    "name": "teknetes-gigs-console-plugin",
    "version": "0.0.1",
    "displayName": "Teknetes Gigs",
    "description": "Run's ad-hoc jobs natively in Kubernetes",
    "exposedModules": {
      "gigUiComponents": "./ui/gigUiComponents.ts"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "peerDependencies": {
    "@babel/core": "^7.0.1",
    "@babel/preset-env": "^7.0.0",
    "babel-loader": "^8.0.2",
    "i18next": "^23.11.5",
    "webpack": "^5.0.0"
  }
}
