#!/usr/bin/bash -e
# stagerunner

{%- macro cli_args(CLI_ARGS) %}
cat <<'          EOF' | sed -E 's/^\s+//g'
    {{ CLI_ARGS }}
EOF
{%- endmacro %}

set -e -E -o pipefail

trap '[[ -z $(gigEnvGet __ERR_LINENO) ]] && gigEnvSet __ERR_LINENO ${LINENO} && gigEnvSet __ERR_FILE_NAME $(basename ${BASH_SOURCE})' ERR

{%- from 'iterator-macro.j2' import realize_iterators %}
{%- set STAGE_FUNCTION_NAME = '__{}_{}'.format(GIG_MOD_DIR_NAME, stage.name) %}

function {{ STAGE_FUNCTION_NAME }}() {
    local __STEP_COUNTER=0
    {%- for step in stage.steps %}
      {%- set GIG_MODULE_NAME = gig_mod.name %}
      {%- set NAMESPACE = gig_mod.namespace %}

      {%- set STEP_GIG_MOD_NAMESPACE = gig_mod.namespace
        if not (step.stageRef and step.stepRef.gigModuleRef.namespace)
        else step.stepRef.gigModuleRef.namespace
      %}
      {%- set STEP_GIG_MOD_NAME = gig_mod.name if not step.stepRef else step.stepRef.gigModuleRef.name %}
      {%- set STEP_RUN_DIR = '{}_{}'.format(STEP_GIG_MOD_NAMESPACE, STEP_GIG_MOD_NAME) %}

      {%- set STEP_SUFFIX = step.name if not (step.stepRef and step.stepRef.name) else step.stepRef.name %}
      {%- set STAGE_PREFIX = stage.name if not (step.stepRef and step.stepRef.stage) else step.stepRef.stage %}
      {%- set STEP_RUN_FILE = '{}_{}'.format(STAGE_PREFIX, STEP_SUFFIX) %}

      {%- set CLI_ARGS = step.args|join(' ') if step.args else '' %}
      {%- set CLI_ARGS = step.defaultArgs|join(' ') ~ CLI_ARGS if step.defaultArgs else CLI_ARGS %}

      {%- set RUN_PARALLEL = '&' if (step.maxParallel and step.maxParallel > 0) else '' %}

      {%- set STEP_FUNCTION_NAME = '{}_{}'.format(STAGE_FUNCTION_NAME, step.name) %}

    function {{ STEP_FUNCTION_NAME }}() {
        export STEP_ID=${1}
        local CURRENT_PID=${BASHPID}
        local CLI_ARGS='{{ CLI_ARGS }}'
        __stepHeader ${STEP_ID} '{{ stage.name }}' '{{ step.name }}' '{{ step.interpreter }}' ${CURRENT_PID}

        {%- if CLI_ARGS %}
        CLI_ARGS=$(
          {%- filter indent(width=10) %}
          {{ cli_args(CLI_ARGS) }}
          {%- endfilter %}
          stepEnvSet CLI_ARGS "${CLI_ARGS}"
        )
        {%- endif %}
        local __STEP_OUTPUT=$(
            {{ '${{GIG_RUN_HOME}}/{}/steprunner__{}.sh'.format(STEP_RUN_DIR, STEP_RUN_FILE)  }} |& __logOutput "${STEP_ID}"
        )
        echo "${__STEP_OUTPUT}"

        __stepFooter ${STEP_ID} '{{ stage.name }}' '{{ step.name }}'
    }

    let __STEP_COUNTER+=1
    unset __SHOULD_RUN
    local __STAGE_STEP_COUNTER="${STAGE_COUNTER}-${__STEP_COUNTER}"
    {%- if step.when %}
    local __WHEN_DIR=${GIG_RUN_HOME}/{{ GIG_MOD_DIR_NAME }}
    (cd ${__WHEN_DIR} && npm link redis >/dev/null &>/dev/null)
    __SHOULD_RUN=$(node ${__WHEN_FILE_NAME}) || exit $?
    {%- endif %}
    if [[ "${__SHOULD_RUN:-true}" == 'true' ]]
    then
      {%- if step.iterate %}
        {{- realize_iterators(step, STEP_FUNCTION_NAME, stage.name, GIG_MOD_DIR_NAME) }}
      {%- else %}
        {% if step.maxParallel -%}
        {{ '__checkMaxThreads ' ~ step.maxParallel }}
        {%- endif %}
        {{ STEP_FUNCTION_NAME }} ${__STAGE_STEP_COUNTER} {{ RUN_PARALLEL }}
      {%- endif %}
    else
        __stepHeader ${__STAGE_STEP_COUNTER} '{{ stage.name }}' '{{ step.name }}' '{{ step.interpreter }}' 'SKIPPED'
    fi
    {%- if step.wait %}

    wait
    {%- endif %}
    {%- endfor %}
}

{{ STAGE_FUNCTION_NAME }}