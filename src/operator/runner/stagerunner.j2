#!/usr/bin/bash -e
mkdir .secrets

STAGE_COUNTER=0
__stageRunner() {
    ${GIG_RUNNER_HOME}/gigrun_header.sh
    {%- set GIG_DEF_DIR_NAME = '{}-{}'.format(gig_def.namespace, gig_def.name) %}

    __saveInputParamsToEnv

    {%- for stage in gig_def.stages %}

    function {{ stage.name }}() {
        __loadStageEnv
        if [[ ! -f ${GIG_RUNNER_HOME}/{{ GIG_DEF_DIR_NAME }}/when-{{ stage.name }}.js || \
            $(node ${GIG_RUNNER_HOME}/{{ GIG_DEF_DIR_NAME }}//when-{{ stage.name }}.js) == 'true' ]]
        then
            {%- set HAS_SECRETS = 'HAS_SECRETS' if stage.secretVars else '' %}
            ${GIG_RUNNER_HOME}/stage_header.sh ${STAGE_COUNTER} \
                '{{ stage.name }}' '{{ stage.scriptType }}' '{{ stage.description }}' {{ HAS_SECRETS }}

            {%- if ('command' in stage) %}
                {%- set STAGE_SCRIPT = stage.command % '${{GIG_RUNNER_HOME}}/{}/{}'.format(GIG_DEF_DIR_NAME, stage.name) %}
            {{ STAGE_SCRIPT }}
            {%- elif (stage.gigDefinitionRef) %}
                {%- set NAMESPACE = stage.gigDefinitionRef.get(namespace, None) %}
                {%- set NAMESPACE = NAMESPACE if NAMESPACE else gig_def.metadata.namespace %}
            ${GIG_RUNNER_HOME}/{{ NAMESPACE }}-{{ stage.gigDefinitionRef.name }}/stagerunner.sh
            {%- else %}
                {%- if not stage.secretVars %}

            set -x
                {%- endif %}
            {% filter indent(width=12) %}
            {{- stage.script }}
            {%- endfilter %}
            { set +x; } 2>/dev/null
            {%- endif %}

            __loadStageEnv
            {%- if stage.secretVars %}
            {% for secretVar in stage.secretVars %}
            echo "${ {{- secretVar }}}" >> .secrets/{{ secretVar }}
            {%- endfor %}
            {%- endif %}

            __endStage '{{ stage.name }}' '{{ stage.scriptType }}'
        else
            ${GIG_RUNNER_HOME}/stage_header.sh $((++STAGE_COUNTER)) \
                '{{ stage.name }}' '{{ stage.scriptType }}' '{{ stage.description }}' 'SKIPPED'
        fi
    }
    ((STAGE_COUNTER+=1))
    {%- if (stage.parallel) %}
    echo '******************************************************************'
    echo "** STAGE ${STAGE_COUNTER} RUNNING IN THE BACKGROUND"
    echo '******************************************************************'
    {{ stage.name }} 2>&1 | __filterLogOutput >> gig.log &
    {%- else %}
    {{ stage.name }} 2>&1 | __filterLogOutput >> gig.log
    {%- endif %}
    {%- if (stage.wait) %}

    wait
    {%- endif %}
    {%- endfor %}
}

__stageRunner
echo $? > .stagerunner_exit_status