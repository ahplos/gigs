#!/usr/bin/bash -e

SECRETS_FILE="$(dirname ${0})/.secrets"
if [[ -f ${SECRETS_FILE} ]]
then
    echo $(cat ${SECRETS_FILE}) >> .secrets
fi

echo "$(__saveInputParamsToEnv)" 2>&1 | __filterLogOutput

PARENT_STAGE="${1}"
STAGE_COUNTER=0
__stageRunner() {
    {%- set GIG_DEF_DIR_NAME = '{}-{}'.format(gig_def.namespace, gig_def.name) %}
    {%- for stage in gig_def.stages %}

    function {{ stage.name }}() {
        __loadStageEnv

        if [[ ! -f ${GIG_RUNNER_HOME}/{{ GIG_DEF_DIR_NAME }}/when-{{ stage.name }}.js || \
            $(node ${GIG_RUNNER_HOME}/{{ GIG_DEF_DIR_NAME }}//when-{{ stage.name }}.js) == 'true' ]]
        then
            {%- set HAS_SECRETS = 'HAS_SECRETS' if stage.secretVars else '' %}
            {%- if (not stage.gigDefinitionRef) %}
            __stage_header ${STAGE_ID} '{{ stage.name }}' '{{ stage.scriptType }}' '{{ stage.description }}' {{ HAS_SECRETS }}
            {%- endif %}

            {%- if ('command' in stage) %}
                {%- set STAGE_SCRIPT = stage.command % '${{GIG_RUNNER_HOME}}/{}/{}'.format(GIG_DEF_DIR_NAME, stage.name) %}
            {{ STAGE_SCRIPT }}
            {%- elif (stage.gigDefinitionRef) %}
                {%- set NAMESPACE = stage.gigDefinitionRef.get(namespace, None) %}
                {%- set NAMESPACE = NAMESPACE if NAMESPACE else gig_def.metadata.namespace %}
            ${GIG_RUNNER_HOME}/{{ NAMESPACE }}-{{ stage.gigDefinitionRef.name }}/stagerunner.sh ${STAGE_ID}
            {%- else %}
                {%- if not stage.secretVars %}

            set -x
                {%- endif %}
            {% filter indent(width=12) %}
            {{- stage.script }}
            {%- endfilter %}
            { set +x; } 2>/dev/null
            {%- endif %}

            __loadStageEnv
            {%- if stage.secretVars %}
            {%- for secretVar in stage.secretVars %}
            echo "${ {{- secretVar }}}" >> .secrets
            {%- endfor %}
            {%- endif %}

            {%- if (not stage.gigDefinitionRef) %}
            if [[ '{{ stage.scriptType }}' == 'Input' ]]
            then
                __waitForUserInput {{ stage.name }}
            fi

            echo
            echo 'STAGE COMPLETE: {{ stage.name }}'
            {%- endif %}
        else
            __stage_header ${STAGE_ID} '{{ stage.name }}' '{{ stage.scriptType }}' '{{ stage.description }}' 'SKIPPED'
        fi
    }
    ((STAGE_COUNTER+=1))
    STAGE_ID="${PARENT_STAGE}${PARENT_STAGE:+-}$(printf '%02d' ${STAGE_COUNTER})"
    {%- if (stage.parallel) %}
    echo '******************************************************************'
    echo "** STAGE ${STAGE_COUNTER} RUNNING IN THE BACKGROUND"
    echo '******************************************************************'
    {{ stage.name }} 2>&1 | __filterLogOutput "${STAGE_ID}" &
    {%- else %}
    {{ stage.name }} 2>&1 | __filterLogOutput "${STAGE_ID}"
    {%- endif %}
    {%- if (stage.wait) %}

    wait
    {%- endif %}
    {%- endfor %}
}

__stageRunner
echo $? > .stagerunner_exit_status