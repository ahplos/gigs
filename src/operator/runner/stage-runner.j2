#!/usr/bin/bash -e

function __stagerunner() {
    local STAGE_COUNTER=0
    {%- for stage in gig_mod.spec.stages %}
      {%- set STAGE_GIG_MOD_NAMESPACE = gig_mod.namespace
        if not (stage.stageRef and stage.stageRef.gigModuleRef.namespace) else stage.stageRef.gigModuleRef.namespace %}
      {%- set STAGE_GIG_MOD_NAME = gig_mod.name if not stage.stageRef else stage.stageRef.gigModuleRef.name %}

      {%- set STAGE_NAME = stage.name if not (stage.stageRef and stage.stageRef.name) else stage.stageRef.name %}
      {%- set STAGE_FUNCTION_NAME = '{}_{}'.format(GIG_MOD_DIR_NAME, stage.name) %}
      {%- set RUN_PARALLEL = '&' if stage.parallel else '' %}

    function __{{ STAGE_FUNCTION_NAME }}() {
        if [[ $(__testWhen '{{ GIG_MOD_DIR_NAME }}' '{{ stage.name }}') == 'true' ]]
        then
            __stageHeader ${1} '{{ stage.name }}'
            source ${GIG_RUNNER_HOME}/{{ STAGE_GIG_MOD_NAMESPACE }}_{{ STAGE_GIG_MOD_NAME }}/{{ STAGE_NAME }} ${STAGE_COUNTER}
            __stageFooter ${1} '{{ stage.name }}'
        else
            __stageHeader ${1} '{{ stage.name }}' 'SKIPPED'
        fi
    }
    __{{ STAGE_FUNCTION_NAME }} ((STAGE_COUNTER+=1)) {{ RUN_PARALLEL }}

    {%- if stage.wait %}

    wait
    {%- endif %}
    {%- endfor %}
}

__stagerunner
