{%- macro step_or_stage_exec(FUNCTION_NAME, ITER_ID, INDENT, RUN_PARALLEL, STAGE_NAME=None) %}
    {%- filter indent(width=INDENT) %}
    {%- if not STAGE_NAME %}
    __{{ FUNCTION_NAME }} "${_STAGE_COUNTER}({{ ITER_ID }})" 2>&1 {{ RUN_PARALLEL }}
    {%- else %}
    __{{ FUNCTION_NAME }} "${_STEP_ID}({{ ITER_ID }})" 2>&1 | __filterStepLogOutput "${_STEP_ID}({{ ITER_ID }})" {{ RUN_PARALLEL }}
    {%- endif %}
    {%- endfilter %}
{%- endmacro %}

{%- macro realize_iterators(stage_or_step, FUNCTION_NAME, RUN_PARALLEL, STAGE_NAME=None) %}
{%- set INDENT = 4 %}
{%- set ITERATOR_ID = namespace(ID=[]) %}
{%- for iter in stage_or_step.iterate.loops %}
    {%- set ITERATOR_ID.ID = ITERATOR_ID.ID + ['${{{}_COUNTER}}'.format(iter.name)] %}
{%- endfor %}
{%- set ITERATOR_ID = namespace(ID=ITERATOR_ID.ID|join('-')) %}
{%- for iter in stage_or_step.iterate.loops %}
    {%- filter indent(width=((loop.index) * INDENT)) %}
    {%- if iter.envVar %}
    OLD_IFS=${IFS}
    IFS='{{ iter.envVar.delim }}' read -ra {{ iter.name }}_ARRAY <<< "${{ iter.envVar.name}}"
    {%- set VALUES = '${{{}_ARRAY[@]}}'.format(iter.name) %}
    {%- elif iter.range %}
      {%- set VALUES = '{{{}..{}..{}}}'.format(iter.range.first , iter.range.last , iter.range.incr) %}
    {%- else %}
    {{ iter.name }}_ARRAY=(
      {%- for val in iter.vector %}
        {{ val }}
      {%- endfor %}
    )
      {%- set VALUES = '${{{}_ARRAY[@]}}'.format(iter.name) %}
    {%- endif %}
    local {{ '{}_COUNTER'.format(iter.name) }}=0
    for {{ iter.name }} in {{ VALUES }}
    do
    {%- endfilter %}
    {%- set INDENT = INDENT + 4 %}
{%- endfor %}
{%- set FUNCTION_INDENT = (stage_or_step.iterate|length) * INDENT %}
{%- filter indent(width=FUNCTION_INDENT) %}
        {%- if stage_or_step.iterate.when %}
        if [[ $(__testWhen '{{ stage_or_step.iterate.when }}') != 'false' ]]
        then
            {{- step_or_stage_exec(FUNCTION_NAME, ITERATOR_ID.ID, FUNCTION_INDENT, RUN_PARALLEL, STAGE_NAME) }}
        else
            {%- if not STAGE_NAME %}
            __stageHeader "${__STAGE_COUNTER}({{ ITERATOR_ID.ID }})" '{{ stage_or_step.name }}' 'SKIPPED' 2>&1 | \
                __filterStageLogOutput "${_STAGE_COUNTER}({{ ITERATOR_ID.ID }})"
            {%- else %}
            __stepHeader "${__STEP_ID}({{ ITERATOR_ID.ID }})" '{{ STAGE_NAME }}' '{{ stage_or_step.name }}' '{{ stage_or_step.interpreter }}' 'SKIPPED' | \
                __filterStepLogOutput "${_STEP_ID}({{ ITERATOR_ID.ID }})"
            {%- endif %}
        fi
        {%- else %}
            {{- step_or_stage_exec(FUNCTION_NAME, ITERATOR_ID.ID, FUNCTION_INDENT, RUN_PARALLEL, STAGE_NAME) }}
        {%- endif %}
{%- endfilter %}
{%- for iter in (stage_or_step.iterate.loops|reverse) %}
    {%- filter indent(width=(((loop.length + 1) - loop.index) * INDENT)) %}
        let {{ '{}_COUNTER'.format(iter.name) }}+=1
    done
    {%- endfilter %}
    {%- set INDENT = INDENT - 4 %}
{%- endfor %}
{%- endmacro %}