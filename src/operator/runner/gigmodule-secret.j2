{%- set GIG_MOD_DIR_NAME = '{}_{}'.format(gig_mod.namespace, gig_mod.name) %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ gig_mod.namespace }}.{{ gig_mod.name }}
  namespace: {{ gig_mod.namespace }}
  labels:
    ahplos.batch.gigs/name: {{ gig_mod.name }}
    ahplos.batch.gigs/source-namespace: {{ gig_mod.namespace }}
type: gigmodule
stringData:
{%- if gig_mod.spec.mode != 'Library' %}
  {%- if gig_mod.spec.secretVars %}
  .secrets: |-
    {%- for secretVar in gig_mod.spec.secretVars %}
    {{ secretVar }}
    {%- endfor %}
    {# blank line #}
  {%- endif %}
  gigrunner.sh: |-
    {% filter indent(width=4) %}
      {%- include 'gigrunner.j2' %}
    {%- endfilter %}
    {# blank line #}
{%- endif %}
{%- for stage in gig_mod.spec.stages %}
  {%- if stage.steps %}
    {%- if stage.mode != 'Library' %}
  stage__{{ stage.name }}: |-
    {% filter indent(width=4) %}
      {%- include 'stagerunner.j2' %}
    {%- endfilter %}
    {%- endif %}

    {%- for step in stage.steps %}
      {%- if not step.stepRef %}
        {%- set STEP_NAME = '{}_{}'.format(stage.name, step.name) %}

  step__{{ STEP_NAME }}: |-
        {%- if step.interpreter == 'Shell' %}
    #!/usr/bin/bash
    trap '[[ -z $(gigEnvGet __ERR_LINENO) ]] && gigEnvSet __ERR_LINENO ${LINENO} && gigEnvSet __ERR_FILE_NAME $(basename ${BASH_SOURCE})' ERR
    set -x
    {# blank line #}
        {%- endif %}
    {% filter indent(width=4) %}
      {{- step.sourceCode }}
    {%- endfilter %}
        {%- if step.interpreter == 'Shell' %}
    { set +x; } 2>/dev/null
        {%- endif %}

  steprunner__{{ STEP_NAME }}.sh: |-
    {% filter indent(width=4) %}
      {%- include 'steprunner.j2' %}
    {%- endfilter %}

      {%- endif %}
    {%- endfor %}
  {%- endif %}
{%- endfor %}

  whenStmtGatherEnvData.js: |-
    import { createClient } from 'redis';
    export async function gatherEnvData() {
        const env = {...process.env}

        const client = createClient();
        await client.connect();
        const gigEnv = await client.hGetAll('GIG_ENV');
        const stageEnv = env.STAGE_ID ? await client.hGetAll(env.STAGE_ID) : {}
        const stepEnv = env.STAGE_ID ? await client.hGetAll(env.STEP_ID) : {}
        await client.quit();

        return [env, gigEnv, stageEnv, stepEnv]
    }
    {# blank line #}

{%- macro test_when(WHEN_STMT) %}
import { gatherEnvData } from './whenStmtGatherEnvData.js'
const [env, gigEnv, stageEnv, stepEnv] = await gatherEnvData()

console.log({{ WHEN_STMT }})
{%- endmacro %}

{%- for stage in gig_mod.spec.stages %}
  {%- if stage.when %}
  stage__{{ stage.name }}_when.js: |-
    {%- filter indent(width=4) %}
      {{- test_when(stage.when) }}
    {%- endfilter %}
    {# blank line #}
  {%- endif %}
  {%- if stage.iterate %}
    {%- for a_loop in stage.iterate.loops %}
      {%- if a_loop.when %}
  stage__{{ stage.name }}_{{ a_loop.name }}_when.js: |-
    {%- filter indent(width=4) %}
      {{- test_when(a_loop.when) }}
    {%- endfilter %}
    {# blank line #}
      {%- endif %}
    {%- endfor %}
  {%- endif %}
  {%- if stage.steps %}
    {%- for step in stage.steps %}
      {%- set STEP_NAME = '{}_{}'.format(stage.name, step.name) %}
      {%- if step.when %}
  step__{{ STEP_NAME }}_when.js: |-
    {%- filter indent(width=4) %}
      {{- test_when(step.when) }}
    {%- endfilter %}
    {# blank line #}
      {%- endif %}
      {%- if step.iterate %}
        {%- for a_loop in step.iterate.loops %}
          {%- if a_loop.when %}
  step__{{ STEP_NAME }}_{{ a_loop.name }}_when.js: |-
    {%- filter indent(width=4) %}
      {{- test_when(a_loop.when) }}
    {%- endfilter %}
    {# blank line #}
          {%- endif %}
        {%- endfor %}
      {%- endif %}
    {%- endfor %}
  {%- endif %}
{%- endfor %}

