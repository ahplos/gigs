apiVersion: v1
kind: Secret
metadata:
  generateName: {{ gig_run.name }}-
  namespace: {{ gig_run.namespace }}
type: gigrunner
stringData:
{%- for secret_file in SECRET_FILES %}
  {{ secret_file }}: |-
    {% filter indent(width=4) %}
    {%- include secret_file %}
    {%- endfilter %}
{%- endfor %}
  gigrun_template.j2: |-
    {%- raw %}
    apiVersion: batch.ahplos.org/v1beta1
    kind: GigRun
    metadata:
      generateName: {{ gig.name }}-
      namespace: {{ gig.namespace }}
    spec:
      gigRef:
        name: {{ gig.name }}
      inputReceived: true
      inputValues: JSON.stringify(inputValues)
    {%- endraw %}
