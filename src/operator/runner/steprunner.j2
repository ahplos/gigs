#!/usr/bin/bash
# steprunner

set -e -E -o pipefail

{%- set HAS_SECRETS = 'HAS_SECRETS' if step.secretVars else '' %}
{%- if HAS_SECRETS %}
gigSecretsAdd {{ step.secretVars | join(' ') }}
{%- endif %}

RUNTIME_TYPE={{ step.runtime.type if (step.runtime and step.runtime.type) else 'Script' }}
RUNTIME={{ step.runtime.name if step.runtime else 'Shell' }}

stepEnvSet RUNTIME_TYPE ${RUNTIME_TYPE}
stepEnvSet RUNTIME ${RUNTIME}
stepEnvSet STAGE_NAME {{ stage.name }}
stepEnvSet STEP_NAME {{ step.name }}
stepEnvSet STEP_FILE {{ '$GIGRUN_HOME/{}/step__{}_{}'.format(GIGMOD_DIR_NAME, stage.name, step.name) if step.script else step.scriptPath }}
stepEnvSet PWD "$(pwd)"
{%- if step.outputFile %}
stepEnvSet OUTPUT_FILE '{{ step.outputFile }}'
{%- endif %}

{%- if (step.runtime and step.runtime.gigModuleRef) %}
RUNTIME_SCRIPT_DIR=${GIGRUN_HOME}/{{ '{}_{}'.format(step.runtime.gigModuleRef.namespace, step.runtime.gigModuleRef.name) }}
{%- endif %}

source ${GIGRUN_DEFAULT_SCRIPTS_HOME}/step-error-handler.sh
source ${RUNTIME_SCRIPT_DIR:-${GIGRUN_DEFAULT_SCRIPTS_HOME}}/runtime__${RUNTIME_TYPE}_${RUNTIME} |& __logOutput ${GIGRUN_SUPPRESS_OUTPUT}

stepEnvSet __STEP_RESULT $?