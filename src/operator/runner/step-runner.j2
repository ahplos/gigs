#!/usr/bin/bash -e
# step-runner
{%- set STAGE_FUNCTION_NAME = '{}_{}'.format(GIG_MOD_DIR_NAME, stage.name) %}

STAGE_COUNTER=${1}
function __{{ STAGE_FUNCTION_NAME }}() {
    local STEP_COUNTER=0
    {%- for step in stage.steps %}
      {%- set GIG_MODULE_NAME = gig_mod.name %}
      {%- set NAMESPACE = gig_mod.namespace %}

      {%- set STEP_GIG_MOD_NAMESPACE = gig_mod.namespace
        if not (step.stageRef and step.stepRef.gigModuleRef.namespace) else step.stepRef.gigModuleRef.namespace %}
      {%- set STEP_GIG_MOD_NAME = gig_mod.name if not step.stepRef else step.stepRef.gigModuleRef.name %}
      {%- set STEP_RUN_DIR = '{}_{}'.format(STEP_GIG_MOD_NAMESPACE, STEP_GIG_MOD_NAME) %}

      {%- set STEP_STAGE_NAME = stage.name if not step.stepRef else step.stepRef.stage %}
      {%- set STEP_NAME = step.name if not (step.stepRef and step.stepRef.name) else step.stepRef.name %}
      {%- set STEP_RUN_NAME = '{}_{}'.format(STEP_STAGE_NAME, STEP_NAME) %}

      {%- set RUN_PARALLEL = '&' if step.parallel else '' %}

    {%- set STEP_FUNCTION_NAME = '{}_{}'.format(STAGE_FUNCTION_NAME, step.name) %}

    function __{{ STEP_FUNCTION_NAME }}() {
        local STAGE_COUNTER=${1}
        local STEP_COUNTER=${2}

        if [[ $(__testWhen '{{ GIG_MOD_DIR_NAME }}' '{{ stage.name }}-{{ step.name }}') == 'true' ]]
        then
            __stepHeader ${STAGE_COUNTER} ${STEP_COUNTER} '{{ stage.name }}' '{{ step.name }}' '{{ step.interpreter }}' {{ HAS_SECRETS }}
            source {{ '${{GIG_RUNNER_HOME}}/{}/{}-run.sh'.format(STEP_RUN_DIR, STEP_RUN_NAME) }}
            __stepFooter ${STAGE_COUNTER} ${STEP_COUNTER} '{{ stage.name }}' '{{ step.name }}'
        else
            __stepHeader ${STAGE_COUNTER} ${STEP_COUNTER} '{{ stage.name }}' '{{ step.name }}' '{{ step.interpreter }}' 'SKIPPED'
        fi
    }
    __{{ STEP_FUNCTION_NAME }} ${STAGE_COUNTER} ((STEP_COUNTER+=1)) 2>&1 | __filterLogOutput "[${STAGE_COUNTER}-${STEP_COUNTER}]" {{ RUN_PARALLEL }}
    {%- if (step.wait) %}

    wait
    {%- endif %}
    {%- endfor %}
}

__{{ STAGE_FUNCTION_NAME }}