apiVersion: v1
kind: Secret
metadata:
  name: {{ gig_def.namespace }}-{{ gig_def.name }}
  namespace: {{ gig_def.namespace }}
type: stagerunner
stringData:
  stagerunner.sh: |-
    {% filter indent(width=4) %}
    {%- include 'stagerunner.j2' %}
    {%- endfilter %}

{%- set EMPTY_SCRIPT_TYPES = ('Shell', 'GigDefinition')  %}
{%- for stage in gig_def.stages %}
  {%- if stage.scriptType not in EMPTY_SCRIPT_TYPES %}
  {{ stage.name }}: |-
    {% filter indent(width=4) %}
    {{- stage.script }}
    {%- endfilter %}
  {% endif %}
  {%- if stage.when %}
  {%- set WHEN_FILE_NAME = 'when-{}.js'.format(stage.name) %}
  {{ WHEN_FILE_NAME }}: |-
    const env = {...process.env}
    result = (Boolean({{ stage.when }}))
    console.log(result)
  {% endif %}
{%- endfor %}

  .secrets: |-
  {% for secretVar in gig_def.secretEnvVars %}
    {{ secretVar }}
  {%- endfor %}