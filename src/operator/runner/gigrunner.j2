#!/usr/bin/bash -e
# gigrunner

{%- import 'iterator-macro.j2' as iter_macros %}

{%- macro run_stage(stage, STAGE_GIG_MOD_NAMESPACE, STAGE_GIG_MOD_NAME, STAGE_NAME) %}
    local CURRENT_PID=${BASHPID}
    __stageHeader ${__STAGE_COUNTER} '{{ stage.name }}' ${CURRENT_PID} | __filterStageLogOutput ${_STAGE_COUNTER}
    . ${GIG_RUN_HOME}/{{ STAGE_GIG_MOD_NAMESPACE }}_{{ STAGE_GIG_MOD_NAME }}/stage__{{ STAGE_NAME }} ${__STAGE_COUNTER}
    (echo && echo "==> STAGE ${__STAGE_COUNTER} COMPLETE: {{ stage.name }} <==") | __filterStageLogOutput ${_STAGE_COUNTER}
{%- endmacro %}

function __gigrunner() {
    set -e
    set -o pipefail

    local _STAGE_COUNTER=00

    echo "$(__gigRunHeader)" | __filterStageLogOutput '--'

    __verifyRequiredInputParams

    {%- for stage in gig_mod.spec.stages %}
      {%- set STAGE_NAME = stage.name if not (stage.stageRef and stage.stageRef.name) else stage.stageRef.name %}
      {%- set STAGE_GIG_MOD_NAMESPACE = gig_mod.namespace
        if not (stage.stageRef and stage.stageRef.gigModuleRef.namespace) else stage.stageRef.gigModuleRef.namespace %}
      {%- set STAGE_GIG_MOD_NAME = gig_mod.name if not stage.stageRef else stage.stageRef.gigModuleRef.name %}

      {%- set STAGE_FUNCTION_NAME = '__{}_{}'.format(GIG_MOD_DIR_NAME, stage.name) %}

      {%- set RUN_PARALLEL = '&' if (stage.maxParallel and stage.maxParallel > 0) else '' %}

    function {{ STAGE_FUNCTION_NAME }}() {
        local __STAGE_COUNTER=${1}
        {%- filter indent(width=4) %}
        {{- run_stage(stage, STAGE_GIG_MOD_NAMESPACE, STAGE_GIG_MOD_NAME, STAGE_NAME) }}
        {%- endfilter %}
    }

    let _STAGE_COUNTER+=1
    __loadEnv
    export -f {{ STAGE_FUNCTION_NAME }}
    export __EXP_STAGE_ID="${_STAGE_COUNTER}"
    {%- if stage.when %}
    local __WHEN=$(__testWhen '{{ stage.when | replace("'", "'\\''") }}')
    if [[ ${__WHEN,,} == 'true' ]]
    then
      {%- if stage.iterate %}
        {{- iter_macros.realize_iterators(stage, STAGE_FUNCTION_NAME) }}
      {%- else %}
        {{- iter_macros.check_max_threads(stage.maxParallel) }}
        {{ STAGE_FUNCTION_NAME }} ${__EXP_STAGE_ID} 2>&1 {{ RUN_PARALLEL }}
      {%- endif %}
    else
        __stageHeader ${__EXP_STAGE_ID} '{{ stage.name }}' ${BASHPID} 'SKIPPED' | __filterStageLogOutput ${__EXP_STAGE_ID}
    fi
    {%- else %}
      {%- if stage.iterate %}
    {{- iter_macros.realize_iterators(stage, STAGE_FUNCTION_NAME) }}
      {%- else %}
    {{ iter_macros.check_max_threads(stage.maxParallel) }}
    {{ STAGE_FUNCTION_NAME }} ${__EXP_STAGE_ID} 2>&1 {{ RUN_PARALLEL }}
      {%- endif %}
    {%- endif %}

    {%- if stage.wait or loop.index == gig_mod.spec.stages|length %}

    wait
    {%- endif %}
    {%- endfor %}
}

__gigrunner
echo $? > .stagerunner_exit_status


