#!/usr/bin/bash -e
set -e

function __gigrunner() {
    local _STAGE_COUNTER=0

    echo "$(__gigRunHeader)" | __filterStageLogOutput ${_STAGE_COUNTER}

    {%- for stage in gig_mod.spec.stages %}
      {%- set STAGE_GIG_MOD_NAMESPACE = gig_mod.namespace
        if not (stage.stageRef and stage.stageRef.gigModuleRef.namespace) else stage.stageRef.gigModuleRef.namespace %}
      {%- set STAGE_GIG_MOD_NAME = gig_mod.name if not stage.stageRef else stage.stageRef.gigModuleRef.name %}

      {%- set STAGE_NAME = stage.name if not (stage.stageRef and stage.stageRef.name) else stage.stageRef.name %}
      {%- set STAGE_FUNCTION_NAME = '{}_{}'.format(GIG_MOD_DIR_NAME, stage.name) %}
      {%- set RUN_PARALLEL = '&' if stage.parallel else '' %}

    function __{{ STAGE_FUNCTION_NAME }}() {
        local __STAGE_COUNTER=${1}

        __loadStageEnv
        if [[ "$(__testWhen '{{ GIG_MOD_DIR_NAME }}' '{{ stage.name }}')" != 'false' ]]
        then
            __stageHeader ${__STAGE_COUNTER} '{{ stage.name }}'
            source ${GIG_RUN_HOME}/{{ STAGE_GIG_MOD_NAMESPACE }}_{{ STAGE_GIG_MOD_NAME }}/{{ STAGE_NAME }} ${__STAGE_COUNTER}
            echo
            echo "==> STAGE ${__STAGE_COUNTER} COMPLETE: {{ stage.name }} <=="
        else
            __stageHeader ${__STAGE_COUNTER} '{{ stage.name }}' 'SKIPPED'
        fi
    }
    let _STAGE_COUNTER+=1
    __{{ STAGE_FUNCTION_NAME }} ${_STAGE_COUNTER} 2>&1 | __filterStageLogOutput ${_STAGE_COUNTER} {{ RUN_PARALLEL }}

    {%- if stage.wait %}

    wait
    {%- endif %}
    {%- endfor %}

  let _STAGE_COUNTER+=1
  __gigRunFooter | __filterStageLogOutput ${_STAGE_COUNTER}
}

__gigrunner
